define isprime(m) {
for(k=2;k<=sqrt(m);k++) {
  if (m%k==0) return 0
}
return 1
}
define pfour(n) {
factors=0
for (i=2;i<=sqrt(n);i++) {
  if (n%i==0) {
     if (isprime(i)) factors = factors+1
     if (isprime(n/i)) factors = factors+1
  }
  if (factors > 4) break
}
if (factors==4) {
return 1 
} else {
return 0
}
}
state=0
maxs=0
for (j=130000;j<1000000;j++) {
  if (pfour(j)==1) {
    state = state+1
  } else {
    state=0
  }
  if (state>maxs) maxs= state
  if (j%1000==0) {
      print "reached ",j, " ", maxs, "\n"
      maxs =0
  }
  if (state==4) break
}
print "the numbers are ", j-3, "\n"
