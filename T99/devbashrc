function looper
{
    if [ $# -ne 3 ] ;then
        echo Usage: looper \"cmd\" loopcnt delay
        return
    fi
    for i in `seq 1 $2`
    do 
        a=`$1`
        echo $i">>" $a
        sleep $3
    done
}
function gcherry
{
    if [ $# -ne 3 ] ;then
        echo Usage: gcherry dest-branch src-branch cherry
        return
    fi
    dest=$1
    src=$2
    cherry=$3
    hg update $dest
    hg transplant -b $src $cherry
    echo Dont forget to push.
    #hg push
}
function ggraft
{
    if [ $# -ne 2 ] ;then
        echo Usage: ggraft dest-branch cherry
        return
    fi
    dest=$1
    cherry=$2
    hg pull
    hg update $dest
    hg graft $cherry
    echo Dont forget to push.
    #hg push
}
function pi
{
  if [ $# -ne 1 ] ;then
      scale=100
  else
      scale=$1
  fi
  bc << END-OF-INPUT
  scale=$scale
  define myfunc(s,j){
    return (s*4)/(j*(j+1)*(j+2))
  }
  s=1
  j=2
  pi=3
  for (i=1; i<scale; i++) {
    pi += myfunc(s,j)
    j=j+2
    s=-s
  }
print pi, "\n"
END-OF-INPUT
}

function unpack()
{
    mkdir /mnt/bdom
    mount $(list_disks -i)1 /mnt/bdom
    mkdir /root/ird-explode
    cd /root/ird-explode
    N=$(cat /proc/cmdline | awk '{print $2}' | cut -c 10)
    gunzip -c /mnt/bdom/initrd-p${N} | cpio -iv
}

function pack()
{
    cd /root/ird-explode
    N=$(cat /proc/cmdline | awk '{print $2}' | cut -c 10)
    find . | cpio -H newc -o | gzip -9 > /mnt/bdom/initrd-p${N}
}

function cleanup-mount()
{
    cd ~
    rm -rf /root/ird-explode/
    umount /mnt/bdom
}

function dog-off()
{
    ipmitool mc watchdog off
}

function dog-on()
{
    echo -n 'v' > /dev/watchdog
    ipmitool mc watchdog reset
}

